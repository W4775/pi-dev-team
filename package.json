{
  "name": "pi-dev-team",
  "version": "0.3.0",
  "description": "Pi extension: /devteam scouts, plans, and builds a vertical slice with specialized implementors, then reviews, tests, and optionally demos.",
  "keywords": [
    "pi-package"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/W4775/pi-dev-team.git"
  },
  "homepage": "https://github.com/W4775/pi-dev-team",
  "bugs": {
    "url": "https://github.com/W4775/pi-dev-team/issues"
  },
  "license": "MIT",
  "type": "module",
  "files": [
    "src",
    "roles",
    "skills",
    "catalog",
    "NOTICE",
    "WHERE-IS-WORKFLOW-STATE.md",
    "LICENSE",
    "vendor-licenses"
  ],
  "scripts": {
    "test": "node --test --experimental-strip-types test/*.test.ts",
    "lint": "oxlint src test",
    "fmt": "oxfmt --write src test",
    "fmt:check": "oxfmt --check src test"
  },
  "dependencies": {
    "typebox": "*"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "omp": {
    "extensions": [
      "./src/index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "engines": {
    "node": ">=22"
  }
}
